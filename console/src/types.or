// The values the console shows: what orbitd's /v1 API answers, decoded (see decode.or).

export type AppSummary = {
  name: string;
  kind: string;
  version: int;
  workerRunning: bool;
  createdAt: int;
};

export type Deployment = {
  id: int;
  version: int;
  module: string;
  spec: string;
  kind: string;
  createdAt: int;
};

export type AppDetail = {
  name: string;
  createdAt: int;
  activeDeployment: int;
  kind: string;
  deployments: Deployment[];
  workerDeployment: int;
};

export type Run = {
  id: string;
  app: string;
  deployment: int;
  trigger: string;
  status: string;
  exitCode: Option<int>;
  error: string;
  startedAt: int;
  wallMs: Option<int>;
  wallUs: Option<int>;
  fuel: Option<int>;
  peakMemory: Option<int>;
  traceId: string;
  hostCalls: string;
};

export type Span = { name: string; parentId: string; startUs: int; endUs: int; attrs: string; };

export type LogLine = {
  id: int;
  app: string;
  level: string;
  message: string;
  ts: int;
  runId: string;
};

export type KvNamespace = { namespace: string; entries: int; };
export type KvEntry = { key: string; value: string; size: int; };
export type KvView = { namespace: string; entries: KvEntry[]; };

export type Queue = { queue: string; ready: int; leased: int; dead: int; done: int; };
export type DeadLetter = { id: int; body: string; attempts: int; lastError: string; };
export type DeadView = { queue: string; letters: DeadLetter[]; };

// One time bucket of GET /v1/stats; the percentiles are None for a bucket without finished runs.
export type StatsBucket = {
  t: int;
  succeeded: int;
  failed: int;
  running: int;
  p50: Option<int>;
  p95: Option<int>;
  logs: int;
};

export type Stats = {
  since: int;
  until: int;
  bucketMs: int;
  buckets: StatsBucket[];
  totals: StatsBucket;
};

// GET /v1/node.
export type NodeInfo = { version: string; abi: int; kinds: string[]; workers: string[]; };
