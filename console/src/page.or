// The HTML around an orin-ui screen: the document, the navigation and the mount element the browser client attaches to.
import { escape } from "std:html";

export type Nav = NavApps | NavRuns | NavLogs | NavQueues | NavNone;

function link(href: string, label: string, here: bool): string {
  return "<a href=\"" + href + "\"" + (here ? " class=\"on\"" : "") + ">" + label + "</a>";
}

function navHtml(nav: Nav): string {
  const apps = match (nav) {
    NavApps => true,
    _ => false,
  };
  const runs = match (nav) {
    NavRuns => true,
    _ => false,
  };
  const logs = match (nav) {
    NavLogs => true,
    _ => false,
  };
  const queues = match (nav) {
    NavQueues => true,
    _ => false,
  };
  return "<nav>" + link("/", "Apps", apps) + link("/runs", "Runs", runs)
      + link("/logs", "Logs", logs) + link("/queues", "Queues", queues) + "</nav>";
}

function shellHead(title: string): string {
  return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
      + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" + "<title>"
      + escape(title)
      + "</title><link rel=\"stylesheet\" href=\"/assets/console.css\"></head><body>";
}

// A screen: `markup` is the HTML of the orin-ui view, `session` the id of its server-side session. `stream` makes the browser
// open the push stream (the live log page); `seq` is the number of the first numbered message the server will send.
export function screenPage(
  title: string,
  nav: Nav,
  markup: string,
  session: string,
  seq: int,
  stream: bool,
): string {
  return shellHead(title) + "<header><h1>Orbit Cloud</h1>" + navHtml(nav)
      + "<form class=\"signout\" method=\"post\" action=\"/logout\"><button type=\"submit\">Sign out</button></form></header>"
      + "<main><div id=\"orin-ui\" data-orin-ui=\"/ui/events\" data-ou-session=\"" + escape(session)
      + "\" data-ou-seq=\"" + seq.toString() + "\""
      + (stream ? " data-ou-stream=\"/ui/stream\"" : "") + ">" + markup
      + "</div></main><script src=\"/assets/orin-ui.js\"></script></body></html>";
}

// The sign-in page. `message` is "" or what went wrong.
export function loginPage(message: string): string {
  return shellHead("Sign in - Orbit Cloud")
      + "<main><form class=\"card login\" method=\"post\" action=\"/login\"><h2>Orbit Cloud</h2>"
      + (message.length > 0 ? "<p class=\"bad\">" + escape(message) + "</p>" : "")
      + "<label for=\"token\">Console token</label>"
      + "<input id=\"token\" name=\"token\" type=\"password\" autocomplete=\"current-password\" autofocus>"
      + "<button type=\"submit\">Sign in</button></form></main></body></html>";
}
