// Shared by the tests: a fake orbitd (an `Api` over canned answers) and a console wired to it.
import { assert } from "std:test";
import { Scope, scope, spawn, channel } from "std:task";
import { TestClient, Router, textAsset } from "orin-web";
import { Dom, DElement, DText, sessionOf } from "orin-ui";
import { Api, ApiRequest, ApiResponse } from "../src/api";
import { Command, hubLoop } from "../src/hub";
import { Deps, buildApp } from "../src/app";
import { program } from "../src/program";
import { Model, Msg, update } from "../src/model";
import { Route, loadModel } from "../src/effects";

export function ok(body: string): ApiResponse {
  return ApiResponse { status: 200, body: body };
}

export function status(code: int, body: string): ApiResponse {
  return ApiResponse { status: code, body: body };
}

function apps(): string {
  return `[{"active_deployment":2,"created_at":1792336579470,"kind":"job","name":"hello","version":2,"worker_running":false},
    {"active_deployment":3,"created_at":1792336579999,"kind":"consumer","name":"worker","version":1,"worker_running":true}]`;
}

function spec(kind: string): string {
  return `{"kind":"` + kind + `","kv_namespaces":["cfg"],"limits":{"memory_mb":64}}`;
}

function helloApp(): string {
  return `{"app":{"name":"hello","created_at":1792336579470,"active_deployment":2},
    "deployments":[
      {"id":1,"app":"hello","version":1,"module":"0fbd9e9e1e654b035c28a97d793f2813c1c8309f34c66874c746565dccc0b83d","spec":`
      + spec("job")
      + `,"created_at":1792336579470},
      {"id":2,"app":"hello","version":2,"module":"aaaabbbbccccddddeeee","spec":{"kind":"job","kv_namespaces":["cfg","seen"],"limits":{"memory_mb":128,"timeout_ms":5000},"env":{"REGION":"eu-west"}},"created_at":1792336580000}],
    "worker_deployment":null}`;
}

function run(id: string, status: string): string {
  return `{"id":"` + id + `","app":"hello","deployment":2,"trigger":"api","status":"` + status
      + `","exit_code":0,"error":null,"started_at":1792336579483,"finished_at":1792336580029,"wall_ms":546,"wall_us":546123,"fuel":null,"peak_memory":1835008,"host_calls":{"log/v1":1},"trace_id":"80eed6fd379d723139e9c2a6fd26043c","message_id":null}`;
}

function trace(): string {
  return `{"trace_id":"80ee","spans":[
    {"trace_id":"80ee","span_id":"87f7","parent_id":null,"run_id":"abc","name":"run","start_us":1000000,"end_us":1546000,"attrs":{"status":"succeeded"}},
    {"trace_id":"80ee","span_id":"11","parent_id":"87f7","run_id":"abc","name":"load","start_us":1000000,"end_us":1100000,"attrs":{"bytes":102298}},
    {"trace_id":"80ee","span_id":"12","parent_id":"87f7","run_id":"abc","name":"execute","start_us":1100000,"end_us":1546000,"attrs":{"exit_code":0}}]}`;
}

function logLine(id: int): string {
  return `{"app":"hello","id":` + id.toString() + `,"level":"info","message":"line ` + id.toString()
      + `","run_id":"abc","ts":` + (1792336580000 + id * 1000).toString() + `}`;
}

// The log lines with an id above `after` out of 1..3.
function logsAbove(after: int): string {
  let parts: string[] = [];
  let i: int = 1;
  while (i <= 3) {
    if (i > after) {
      parts.push(logLine(i));
    }
    i += 1;
  }
  return "[" + parts.join(",") + "]";
}

function afterOf(path: string): int {
  const at = path.indexOf("after=");
  if (at.isNone()) {
    return 0;
  }
  const rest = path.substring(at.unwrap() + 6, path.length);
  const amp = rest.indexOf("&");
  const digits = amp.isSome() ? rest.substring(0, amp.unwrap()) : rest;
  return parseInt(digits).unwrapOr(0);
}

// The answers of the fake orbitd. Unknown requests are a 404 so a wrong path fails a test loudly. `/v1/apps/broken` is a 500 and
// `/v1/apps/svc` is a service (runs answer 409).
export function route(method: string, path: string, body: string): ApiResponse {
  const key = method + " " + path;
  if (method == "GET" && path.startsWith("/v1/stats")) {
    return ok(statsJson(path));
  }
  if (key == "GET /v1/node") {
    return ok(
      `{"kinds":["job","service","consumer"],"orbit_abi":1,"version":"0.1.0","workers":[{"app":"mailer","deployment":3}]}`,
    );
  }
  if (key == "GET /v1/apps") {
    return ok(apps());
  }
  if (key == "GET /v1/apps/hello") {
    return ok(helloApp());
  }
  if (key == "GET /v1/apps/hello/runs?limit=100") {
    return ok("[" + run("abc", "succeeded") + "," + run("def", "failed") + "]");
  }
  if (key == "GET /v1/apps/worker/kv") {
    return ok("[]");
  }
  if (key == "GET /v1/apps/hello/kv") {
    return ok(`[{"namespace":"cfg","entries":2}]`);
  }
  if (key == "GET /v1/apps/hello/kv/cfg?limit=200") {
    return ok(
      `[{"key":"color","value":"blue","size":4,"updated_at":1},{"key":"<b>x</b>","value":"<script>alert(1)</script>","size":25,"updated_at":2}]`,
    );
  }
  if (key == "POST /v1/apps/hello/runs") {
    return ok(run("fresh", "succeeded"));
  }
  if (key == "POST /v1/apps/hello/deployments/1/activate") {
    return ok(helloApp());
  }
  if (key == "DELETE /v1/apps/hello") {
    return status(204, "");
  }
  if (key == "GET /v1/apps/broken") {
    return status(500, `{"error":"store failure"}`);
  }
  if (key == "GET /v1/apps/svc") {
    return ok(
      `{"app":{"name":"svc","created_at":1,"active_deployment":9},"deployments":[{"id":9,"app":"svc","version":1,"module":"ff","spec":`
          + spec("service") + `,"created_at":1}],"worker_deployment":9}`,
    );
  }
  if (key == "GET /v1/apps/svc/runs?limit=100") {
    return ok("[]");
  }
  if (key == "GET /v1/apps/svc/kv") {
    return ok("[]");
  }
  if (key == "POST /v1/apps/svc/runs") {
    return status(409, `{"error":"svc is a service: it runs by itself"}`);
  }
  if (key == "GET /v1/apps/evil") {
    return ok(
      `{"app":{"name":"<img src=x onerror=alert(1)>","created_at":1,"active_deployment":1},"deployments":[{"id":1,"app":"evil","version":1,"module":"<script>alert(1)</script>","spec":{"kind":"job"},"created_at":1}],"worker_deployment":null}`,
    );
  }
  if (key == "GET /v1/apps/evil/runs?limit=100") {
    return ok("[]");
  }
  if (key == "GET /v1/apps/evil/kv") {
    return ok("[]");
  }
  if (key == "GET /v1/runs?limit=100" || key == "GET /v1/runs?limit=200") {
    return ok("[" + run("abc", "succeeded") + "," + run("def", "failed") + "]");
  }
  if (key == "GET /v1/runs/abc") {
    return ok(run("abc", "succeeded"));
  }
  if (key == "GET /v1/runs/abc/trace") {
    return ok(trace());
  }
  if (key == "GET /v1/runs/abc/logs?limit=2000") {
    return ok("[" + logLine(1) + "," + logLine(2) + "]");
  }
  if (key == "GET /v1/queues") {
    return ok(
      `[{"queue":"orders","ready":2,"leased":0,"dead":1,"done":5},{"queue":"idle","ready":0,"leased":0,"dead":0,"done":0}]`,
    );
  }
  if (key == "GET /v1/queues/orders/dead?limit=100") {
    return ok(
      `[{"id":7,"queue":"orders","body":"{\\"id\\":7}","attempts":3,"enqueued_at":1,"lease_token":null,"last_error":"boom"}]`,
    );
  }
  if (key == "POST /v1/queues/orders/redrive") {
    return ok(`{"redriven":1}`);
  }
  if (key == "POST /v1/queues/orders/messages") {
    return status(201, `{"id":42,"queue":"orders"}`);
  }
  if (method == "GET" && path.startsWith("/v1/logs?")) {
    return ok(logsAbove(afterOf(path)));
  }
  return status(404, `{"error":"the fake orbitd has no route ` + key + `"}`);
}

function bucketJson(t: int, ok: int, bad: int, p95: int): string {
  return `{"t":` + t.toString() + `,"succeeded":` + ok.toString() + `,"failed":` + bad.toString()
      + `,"running":0,"p50_us":` + (ok > 0 ? (900 + t % 7 * 10).toString() : "null") + `,"p95_us":`
      + (ok > 0 ? p95.toString() : "null") + `,"logs":` + (ok + bad).toString() + `}`;
}

// Twenty-four hourly buckets ending at 1792400000000; hour 5 has no runs. `app=nobody` has none at all.
function statsJson(path: string): string {
  const until = 1792400000000;
  const since = until - 24 * 3600000;
  const nobody = path.includes("app=nobody");
  let buckets: string[] = [];
  let ok: int = 0;
  let bad: int = 0;
  let i: int = 0;
  while (i < 24) {
    const o = nobody || i == 5 ? 0 : 3 + i % 4;
    const b = nobody || i == 5 ? 0 : i % 6 == 0 ? 1 : 0;
    ok += o;
    bad += b;
    buckets.push(bucketJson(since + i * 3600000, o, b, 2400));
    i += 1;
  }
  return `{"since":` + since.toString() + `,"until":` + until.toString()
      + `,"bucket_ms":3600000,"buckets":[` + buckets.join(",") + `],"totals":`
      + (nobody ? bucketJson(since, 0, 0, 0) : bucketJson(since, ok, bad, 4100)) + `}`;
}

export function fakeApi(): Api {
  return (req: ApiRequest): Result<ApiResponse, string> => Ok(
    route(req.method, req.path, req.body),
  );
}

// An API whose network is down.
export function downApi(): Api {
  return (req: ApiRequest): Result<ApiResponse, string> => Err(
    "cannot reach orbitd at 127.0.0.1:1: connection refused",
  );
}

export function entropy(): string {
  return "00112233445566778899aabbccddeeff" + "ffeeddccbbaa99887766554433221100"
      + "0123456789abcdef0123456789abcdef";
}

export function consoleToken(): string {
  return "console-secret";
}

// Runs `body` against the console with its hub task alive and the API replaced by `api`.
export function withConsoleOn(api: Api, body: (client: TestClient) => void): void {
  scope((s: Scope): void => {
    const cmds = channel<Command>(16);
    const rx = cmds.rx;
    const hubTask = spawn(s, (): int => hubLoop(rx, entropy(), program()));
    const deps = Deps {
      api: api,
      hub: cmds.tx,
      consoleToken: consoleToken(),
      assets: [
        textAsset("console.css", "body { }"),
        textAsset("orin-ui.js", "// client"),
        textAsset("orin-ui-kit.css", ".ou-x { }"),
        textAsset("orin-ui-kit.js", "// kit"),
      ],
      accessLog: false,
      nodeLabel: "orbitd:8080",
    };
    body(new TestClient(buildApp(deps)));
    cmds.tx.close();
    hubTask.join();
  });
}

export function withConsole(body: (client: TestClient) => void): void {
  withConsoleOn(fakeApi(), body);
}

// The text between the first `open` and the next `close` after it ("" when absent).
export function between(text: string, open: string, close: string): string {
  const a = text.indexOf(open);
  if (a.isNone()) {
    return "";
  }
  const start = a.unwrap() + open.length;
  const rest = text.substring(start, text.length);
  const b = rest.indexOf(close);
  return b.isSome() ? rest.substring(0, b.unwrap()) : "";
}

// ------------------------------------------------------------------ finding elements in a screen

function textOf(d: Dom): string {
  return match (d) {
    DText(s) => s,
    DElement(tag, k, attrs, children) => children.map(c => textOf(c)).join(""),
  };
}

function search(nodes: Dom[], tag: string, label: string, prefix: int[]): Option<int[]> {
  let i: usize = 0;
  while (i < nodes.length) {
    const here = prefix.concat([i.toInt()]);
    match (nodes[i]) {
      DElement(t, k, attrs, children) => {
        if (t == tag && textOf(nodes[i]).includes(label)) {
          // prefer the innermost match: a form that contains the label deeper wins over its ancestors
          const deeper = search(children, tag, label, here);
          return deeper.isSome() ? deeper : Some(here);
        }
        const inner = search(children, tag, label, here);
        if (inner.isSome()) {
          return inner;
        }
      },
      DText(s) => {},
    }
    i += 1;
  }
  return None;
}

// The path of the first `tag` element (button, a, form, ...) whose text contains `label`, in the screen of `model`.
export function pathIn(model: Model, tag: string, label: string): int[] {
  const found = search(sessionOf<Model, Msg>(program(), model).dom, tag, label, []);
  assert(found.isSome(), "no <" + tag + "> with text '" + label + "' on the screen");
  return found.unwrap();
}

// The first-render model of a route against the fake, after some messages (a dialog opened, ...).
export function modelAfter(route: Route, msgs: Msg[]): Model {
  let m = loadModel(fakeApi(), route, "orbitd:8080").unwrap();
  for (const msg of msgs) {
    m = update(m, msg);
  }
  return m;
}

export function pathText(p: int[]): string {
  return "[" + p.map(i => i.toString()).join(",") + "]";
}
