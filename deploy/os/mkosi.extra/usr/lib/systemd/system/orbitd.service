[Unit]
Description=Orbit Cloud node (orbitd)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/orbit-cloud

[Service]
Type=exec
User=orbitd
Group=orbitd
# The token arrives as a credential: kernel command line is not used, the file never touches the disk image.
# QEMU: -smbios type=11,value=io.systemd.credential:orbit-cloud.token=SECRET (mkosi: --credential=orbit-cloud.token=SECRET)
ImportCredential=orbit-cloud.*
Environment=ORBIT_CLOUD_LISTEN=0.0.0.0:8080
Environment=ORBIT_CLOUD_DATA=/var/lib/orbit-cloud
ExecStart=/usr/libexec/orbitd-start
Restart=always
RestartSec=2
TimeoutStopSec=30

ReadWritePaths=/var/lib/orbit-cloud
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The WebAssembly engine compiles code at run time, so writable+executable memory must stay allowed.
MemoryDenyWriteExecute=no
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
